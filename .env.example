# Server-only secrets. NEVER prefix with NEXT_PUBLIC_.
# .env is gitignored — committing real tokens is a leak.
# Same keys go in Vercel → Settings → Environment Variables
# (Production / Preview). Do not enable "expose to the browser".
#
# Instagram Graph: long-lived User token + IG professional account id.
# TikTok: Open API access token. Treat both as passwords.

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
